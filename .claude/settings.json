{
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make e2e)",
      "Bash(make gen)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv run pytest *)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run check:bundle)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(graphify query *)",
      "Bash(graphify path *)",
      "Bash(graphify explain *)",
      "Bash(graphify update *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/id_*)",
      "Read(**/.hivora)",
      "Read(**/node_modules/**)",
      "Read(**/.next/**)",
      "Read(**/out/**)",
      "Read(**/.venv/**)",
      "Read(graphify-out/graph.json)",
      "Read(graphify-out/graph.html)",
      "Read(backend/uv.lock)",
      "Read(frontend/package-lock.json)",
      "Read(frontend/lib/api/openapi.json)",
      "Read(frontend/lib/api/schema.d.ts)"
    ]
  }
}
